{
  "name": "fitflow-caragua-landing",
  "private": true,
  "version": "1.0.0",
  "description": "Apresentação pública do projeto acadêmico FitFlow Caraguá",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
